{
  "name": "tristanlee-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler pages dev single-file --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply LIKES_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply LIKES_DB --remote",
    "build": "tsc -b && vite build",
    "build:single": "node scripts/build-single.mjs",
    "test:likes": "node --test tests/likes-api.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "npm run build:single && wrangler pages deploy --project-name tristanlee --branch main"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.132.0"
  }
}
